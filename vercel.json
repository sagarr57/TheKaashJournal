{
  "crons": [
    {
      "path": "/api/publish-scheduled",
      "schedule": "0 0 * * *"
    }
  ],
  "buildCommand": "pnpm build",
  "outputDirectory": "client/dist",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "thekaashjournal.com" },
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://www.thekaashjournal.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "thekaashjournal.com" }],
      "destination": "https://www.thekaashjournal.com/$1",
      "permanent": true
    },
    {
      "source": "/blog/best-ai-health-apps-uk-2025",
      "destination": "/blog/best-ai-health-apps-uk-2026",
      "permanent": true
    },
    {
      "source": "/blog/new-payments-architecture-uk-guide-2026",
      "destination": "/blog/new-payments-architecture-uk",
      "permanent": false
    },
    {
      "source": "/blog/ai-mental-health-tools-nhs-2026-evidence",
      "destination": "/blog/ai-therapy-apps-uk-2026-safe",
      "permanent": false
    },
    {
      "source": "/blog/wise-nasdaq-listing-may-2026",
      "destination": "/blog/uk-fintech-unicorns-2026-revolut-monzo-starling-wise",
      "permanent": false
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/ads.txt",
      "destination": "https://srv.adstxtmanager.com/19390/thekaashjournal.com",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/(tag|admin)(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(sitemap\\.xml|rss\\.xml|robots\\.txt|ads\\.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
