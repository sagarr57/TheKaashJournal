# ─── Supabase ───────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-only — never expose to browser

# ─── Site ───────────────────────────────────────────────────────────────
# Must match your live canonical host (include www if that is what you redirect to).
VITE_SITE_URL=https://www.yoursite.com

# ─── Analytics ──────────────────────────────────────────────────────────
VITE_GTM_ID=GTM-XXXXXXX                                # Google Tag Manager container ID
GA_PROPERTY_ID=your-ga4-property-id                    # GA4 property ID (server-side analytics)
GA_CREDENTIALS={"type":"service_account",...}          # GA4 service account JSON (one line)

# ─── Newsletter (Brevo) ─────────────────────────────────────────────────
# Get from: https://app.brevo.com → Settings → API Keys
VITE_BREVO_API_KEY=your-brevo-api-key
VITE_BREVO_LIST_ID=2                                   # Brevo contact list ID

# ─── Cron Security ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Set this SAME value in Vercel → Settings → Environment Variables
CRON_SECRET=your-random-secret-here

# ─── AdSense ────────────────────────────────────────────────────────────
# Get slot IDs from: AdSense dashboard → Ads → By ad unit → Create ad unit
# Publisher ID is hardcoded in AdUnit.tsx (ca-pub-5606354728180472)
VITE_ADSENSE_SLOT_IN_CONTENT=your-slot-id       # Before article content (currently active)
VITE_ADSENSE_SLOT_POST_CONTENT=your-slot-id     # After article content, before author bio
VITE_ADSENSE_SLOT_END_OF_ARTICLE=your-slot-id   # After author bio, before related posts

# ─── Contact ────────────────────────────────────────────────────────────
VITE_CONTACT_EMAIL=your@email.com
